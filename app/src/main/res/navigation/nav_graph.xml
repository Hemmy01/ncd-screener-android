<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.ncdscreener.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_patient_list"
            app:destination="@id/patientListFragment" />
        <action
            android:id="@+id/action_home_to_new_screening"
            app:destination="@id/screeningFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/patientListFragment"
        android:name="com.example.ncdscreener.fragments.PatientListFragment"
        android:label="Patients"
        tools:layout="@layout/fragment_patient_list">
        <action
            android:id="@+id/action_patient_list_to_patient_detail"
            app:destination="@id/patientDetailFragment" />
        <action
            android:id="@+id/action_patient_list_to_register_patient"
            app:destination="@id/registerPatientFragment" />
        <action
            android:id="@+id/action_patient_list_to_new_screening"
            app:destination="@id/screeningFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerPatientFragment"
        android:name="com.example.ncdscreener.fragments.RegisterPatientFragment"
        android:label="Register Patient"
        tools:layout="@layout/fragment_register_patient">
        <action
            android:id="@+id/action_register_patient_to_patient_detail"
            app:destination="@id/patientDetailFragment"
            app:popUpTo="@id/patientListFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/patientDetailFragment"
        android:name="com.example.ncdscreener.fragments.PatientDetailFragment"
        android:label="Patient Details"
        tools:layout="@layout/fragment_patient_detail">
        <action
            android:id="@+id/action_patient_detail_to_screening_form"
            app:destination="@id/screeningFormFragment" />
        <action
            android:id="@+id/action_patient_detail_to_register_patient"
            app:destination="@id/registerPatientFragment" />
    </fragment>

    <fragment
        android:id="@+id/screeningFormFragment"
        android:name="com.example.ncdscreener.fragments.ScreeningFormFragment"
        android:label="NCD Screening"
        tools:layout="@layout/fragment_screening_form">
        <action
            android:id="@+id/action_screening_form_to_screening_results"
            app:destination="@id/screeningResultsFragment" />
    </fragment>

    <fragment
        android:id="@+id/screeningResultsFragment"
        android:name="com.example.ncdscreener.fragments.ScreeningResultsFragment"
        android:label="Screening Results"
        tools:layout="@layout/fragment_screening_results">
        <action
            android:id="@+id/action_screening_results_to_counseling"
            app:destination="@id/counselingFragment" />
    </fragment>

    <fragment
        android:id="@+id/counselingFragment"
        android:name="com.example.ncdscreener.fragments.CounselingFragment"
        android:label="Counseling"
        tools:layout="@layout/fragment_counseling" />

</navigation>

